<?xml version="1.0" encoding="utf-8"?>
<!--
    Toolbar menu popup panel - Gboard-style card grid
    Shows secondary tools: Back, Settings, Voice, Clipboard, Undo, Redo, Select, Copy, Paste, Move Left, Move Right
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar_menu_popup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/toolbar_menu_popup_background">

    <!-- Row 1: Back, Settings, Voice, Clipboard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/menu_back"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_back_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_back_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_settings_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_settings_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_voice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_voice_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_voice_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_clipboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_clipboard_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_clipboard_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Undo, Redo, Select, Copy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:id="@+id/menu_undo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_undo_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_undo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_redo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_redo_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_redo_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_select"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_select_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_select_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_copy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_copy_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_copy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Paste, Move Left, Move Right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/menu_paste"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_paste_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_paste_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_move_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_move_left_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_move_left_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_move_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/toolbar_menu_item_background"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/menu_move_right_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@android:color/transparent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/menu_move_right_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
